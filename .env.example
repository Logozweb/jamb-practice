# JAMB Practice Platform - Environment Configuration Template
# Copy this file to .env and fill in your values if needed.

# Google OAuth Credentials for Gmail API Dispatch
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Fallback SMTP Relay (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback Resend API (optional)
RESEND_API_KEY=
